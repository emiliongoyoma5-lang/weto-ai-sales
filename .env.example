DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weto_ai_sales?schema=public"
PORT=3000

# WhatsApp Cloud API
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
WHATSAPP_GRAPH_VERSION=replace-with-supported-graph-version

# Natural language AI (optional; deterministic fallback remains active if absent)
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Fase 6 — recuperação automática de vendas
FOLLOW_UP_ENABLED=true
FOLLOW_UP_INTERVAL_SECONDS=60
